(defun ids-evaluate-result-buffer (buffer correct-buffer prefix ccs)
  (let ((line-regexp
	 (format "^%s-\\([0-9]+\\)\t.\t\\([^\t\n\r ]*\\)$"
		 prefix))
	(right-ids 0)
	(wrong-ids 0)
	(right-char 0)
	(wrong-char 0)
	correct-ids normalized-correct-ids
	code ids normalized-ids char is
	Precision Recall)
    (with-current-buffer buffer
      (goto-char (point-min))
      (while (re-search-forward line-regexp nil t)
	(setq code (match-string 1)
	      ids (match-string 2))
	(setq normalized-ids
	      (mapconcat (lambda (char)
			   (char-to-string (hanzi-normalize-char char)))
			 ids ""))
	(setq is
	      (if (= (length ids) 1)
		  (or (char-feature (aref ids 0) 'ideographic-structure)
		      ;; (char-feature (aref ids 0) 'ideographic-structure@apparent)
		      )
		(cdr (assq 'ideographic-structure
			   (ids-parse-string normalized-ids)))))
	(when (consp is)
	  (setq normalized-ids
		(or (mapconcat
		     (lambda (char)
		       (char-to-string (hanzi-normalize-char char)))
		     (ideographic-structure-to-ids
		      (ideographic-structure-compact is))
		     "")
		    normalized-ids)))
	(setq correct-ids
	      (with-current-buffer correct-buffer
		(goto-char (point-min))
		(if (re-search-forward (format "^%s-%s\t.\t" prefix code))
		    (buffer-substring (match-end 0)(point-at-eol)))))
	(setq normalized-correct-ids
	      (cond ((string= correct-ids "")
		     (setq char (decode-char ccs (string-to-number code)))
		     (if char
			 (char-to-string
			  (hanzi-normalize-char char))
		       "")
		     )
		    (t
		     (mapconcat (lambda (char)
				  (char-to-string (hanzi-normalize-char char)))
				correct-ids "")
		     )))
	(cond
	 ((string= normalized-ids normalized-correct-ids)
	  (if (>= (length normalized-ids) 3)
	      (setq right-ids (1+ right-ids))
	    (setq right-char (1+ right-char)))
	  )
	 (t
	  (with-current-buffer "*scratch*"
	    (insert (format "%s-%s\t%s is not %s\n"
			    prefix code ids correct-ids)))
	  (if (>= (length ids) 3)
	      (setq wrong-ids (1+ wrong-ids))
	    (setq wrong-char (1+ wrong-char)))
	  ))))
    (setq Precision
	  (/ (* right-ids 100.0)
	     (+ right-ids wrong-ids)))
    (setq Recall
	  (/ (* right-ids 100.0)
	     (+ right-ids wrong-char)))
    (format "
right-ids  (TP): %4d
wrong-ids  (FP): %4d
wrong-char (FN): %4d
right-char (TN): %4d
--------------------
Total:          %5d

Accuracy    = %02.3f
Precision   = %02.3f
Recall      = %02.3f
Specificity = %02.3f
F           = %02.3f
\n"
	    right-ids wrong-ids wrong-char right-char
	    (+ right-ids wrong-ids wrong-char right-char)
	    (/ (* (+ right-ids right-char) 100.0)
	       (+ right-ids wrong-ids wrong-char right-char))
	    Precision
	    Recall
	    (/ (* right-char 100.0)
	       (+ wrong-ids right-char))
	    (/ (* 2 Precision Recall)
	       (+ Precision Recall))
	    )))
